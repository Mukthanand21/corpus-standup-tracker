# ============================================================
# Corpus Standup Tracker - Example Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- API ---
BASE_URL=https://api.corpus.swecha.org/api/v1

# --- Default Bearer Token (optional) ---
API_TOKEN=

# --- Category IDs ---
STANDUP_CATEGORY_ID=
INTERNSHIP_CATEGORY_ID=

# --- Fetch Settings ---
FETCH_LIMIT=500
